# AWS Credentials (Optional if USE_MOCK_MODEL=true)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_SESSION_TOKEN=your_session_token_if_applicable
AWS_REGION=us-west-2

# Target Bedrock Model ID
# e.g., us.anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# Run in offline simulation / mock mode (Default: true)
# Set to false to run actual calls to Amazon Bedrock
USE_MOCK_MODEL=true

# API Server configuration
PORT=8000
HOST=127.0.0.1
